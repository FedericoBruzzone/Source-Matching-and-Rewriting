FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LLVM_INST_DIR=/usr/local

# Install basic dependencies + GCC/G++
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    g++ \
    python3 \
    libboost-serialization-dev \
    libopenblas-dev \
    ninja-build \
    software-properties-common \
    wget \
 && rm -rf /var/lib/apt/lists/*

# Clone upstream llvm-project directly
WORKDIR /opt
RUN git clone --filter=blob:none https://github.com/llvm/llvm-project.git

# Build LLVM + Clang + MLIR + Flang + LLD
WORKDIR /opt/llvm-project

RUN cmake -G Ninja -S ./llvm -B ./build \
 -DCMAKE_BUILD_TYPE=Release \
 -DCMAKE_INSTALL_PREFIX="${LLVM_INST_DIR}" \
 -DLLVM_ENABLE_ASSERTIONS=ON \
 -DLLVM_ENABLE_PROJECTS="clang;mlir;flang;lld" \
 -DCLANG_ENABLE_CIR=ON \
 -DLLVM_ENABLE_RTTI=ON \
 -DLLVM_TARGETS_TO_BUILD="host" \
 -DCMAKE_CXX_FLAGS="-Wno-error=deprecated-declarations -Wno-deprecated-declarations" \
 -DLLVM_ENABLE_RUNTIMES="compiler-rt;flang-rt"

RUN ninja -j2 -C ./build install \
 && rm -rf ./build

# Symlink flang-new to flang
RUN ln -sf ${LLVM_INST_DIR}/bin/flang-new ${LLVM_INST_DIR}/bin/flang

WORKDIR /root

CMD ["/bin/bash"]